{
  "name": "expo-workspaces",
  "version": "0.1.0",
  "description": "Native projects as code for Expo. Declarative targets, packages, schemes, and Android config for CNG.",
  "license": "MIT",
  "author": "gugell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gugell/expo-workspaces.git"
  },
  "homepage": "https://github.com/gugell/expo-workspaces#readme",
  "bugs": {
    "url": "https://github.com/gugell/expo-workspaces/issues"
  },
  "keywords": [
    "expo",
    "expo-plugin",
    "config-plugin",
    "cng",
    "prebuild",
    "xcode",
    "ios",
    "android",
    "declarative",
    "workspace"
  ],
  "main": "app.plugin.js",
  "types": "build/index.d.ts",
  "bin": {
    "expo-workspaces": "./bin/expo-workspaces.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./app.plugin.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./build/types.js"
    }
  },
  "files": [
    "app.plugin.js",
    "bin",
    "build",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "watch": "tsc -b --watch",
    "clean": "tsc -b --clean && node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "prepack": "pnpm build",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@bacons/xcode": "1.0.0-alpha.32",
    "@expo/plist": "0.7.0",
    "jiti": "^1.21.7"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=56.0.0",
    "expo": ">=56.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": { "optional": true },
    "expo": { "optional": true }
  },
  "devDependencies": {
    "@expo/config-plugins": "^56.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}

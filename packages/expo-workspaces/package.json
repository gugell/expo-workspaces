{
  "name": "expo-workspaces",
  "version": "1.0.0",
  "private": true,
  "description": "Declarative, manifest-first iOS + Android workspace generation for Expo CNG. Meta package composing the expo-workspaces-* capability generators.",
  "license": "MIT",
  "main": "app.plugin.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./app.plugin.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./build/types.js"
    }
  },
  "files": ["app.plugin.js", "build", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test build/**/*.test.js",
    "typecheck": "tsc -b"
  },
  "keywords": ["expo", "expo-plugin", "cng", "manifest", "declarative", "workspace"],
  "dependencies": {
    "@expo-workspaces/core": "workspace:",
    "@expo-workspaces/ios-xcode": "workspace:",
    "@expo-workspaces/ios-pods": "workspace:",
    "@expo-workspaces/ios-targets": "workspace:",
    "@expo-workspaces/ios-spm": "workspace:",
    "@expo-workspaces/patch": "workspace:",
    "@expo-workspaces/android": "workspace:"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=56.0.0",
    "expo": ">=56.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": { "optional": true },
    "expo": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2"
  }
}

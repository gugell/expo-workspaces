{
  "name": "@expo-workspaces/meta",
  "version": "1.0.0",
  "private": true,
  "description": "Internal composition package (bundle source) for expo-workspaces. Composes the @expo-workspaces/* capability generators; bundled into the root `expo-workspaces` package for distribution.",
  "license": "MIT",
  "main": "app.plugin.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./app.plugin.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./build/types.js"
    }
  },
  "files": [
    "app.plugin.js",
    "build",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "expo",
    "expo-plugin",
    "cng",
    "manifest",
    "declarative",
    "workspace"
  ],
  "dependencies": {
    "@expo-workspaces/core": "workspace:",
    "@expo-workspaces/ios-xcode": "workspace:",
    "@expo-workspaces/ios-pods": "workspace:",
    "@expo-workspaces/ios-targets": "workspace:",
    "@expo-workspaces/ios-spm": "workspace:",
    "@expo-workspaces/patch": "workspace:",
    "@expo-workspaces/android": "workspace:"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=56.0.0",
    "expo": ">=56.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2"
  }
}
